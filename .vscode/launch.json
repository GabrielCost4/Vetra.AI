{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: FastAPI (Uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/API",
      "envFile": "${workspaceFolder}/API/infra/.env",
      "justMyCode": true,
      "console": "integratedTerminal"
    }
  ]
}
